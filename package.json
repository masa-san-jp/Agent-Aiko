{
  "name": "agent-aiko",
  "version": "0.0.0",
  "description": "Agent-Aiko — packages/ の workspace ルート。配布物ではない",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "clean": "tsc -b --clean && npm run clean --workspaces --if-present"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/masa-san-jp/Agent-Aiko.git"
  }
}
