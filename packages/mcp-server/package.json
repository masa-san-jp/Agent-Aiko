{
  "name": "aiko-mcp",
  "version": "0.1.0",
  "description": "アイコの人格を、どの AI エージェントからでも同じ形で取り出せる MCP サーバー",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "aiko-mcp": "dist/server.js"
  },
  "files": [
    "dist/server.js",
    "dist/index.js",
    "persona",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/bundle-persona.mjs && node scripts/bundle.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "pretest": "npm run build",
    "test": "node --import tsx --test test/*.test.ts",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/masa-san-jp/Agent-Aiko.git",
    "directory": "packages/mcp-server"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "aiko",
    "persona",
    "ai-agent"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts"
}
