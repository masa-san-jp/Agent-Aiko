{
  "name": "aiko-mcp",
  "version": "0.2.1",
  "mcpName": "io.github.masa-san-jp/aiko",
  "description": "A portable persona for MCP clients — the same agent in Claude Code, Codex, Cursor and VS Code. Runs locally; nothing leaves your machine.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "aiko-mcp": "dist/server.js"
  },
  "files": [
    "dist/server.js",
    "dist/index.js",
    "persona",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/bundle-persona.mjs && node scripts/bundle.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "pretest": "npm run build",
    "test": "node --import tsx --test test/*.test.ts",
    "clean": "tsc -b --clean",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/masa-san-jp/Agent-Aiko.git",
    "directory": "packages/mcp-server"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-code",
    "codex",
    "cursor",
    "vscode",
    "persona",
    "memory",
    "ai-agent",
    "local-first",
    "aiko"
  ],
  "main": "dist/index.js"
}
