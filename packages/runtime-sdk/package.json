{
  "name": "@agent-aiko/runtime-sdk",
  "version": "0.1.0",
  "description": "Aiko Runtime SDK — 各ランタイムが人格を安全かつ一貫して注入するための唯一の公開実行インターフェース。SDK 設計書 §6",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
