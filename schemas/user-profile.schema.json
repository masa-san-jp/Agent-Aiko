{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/masa-san-jp/Agent-Aiko/schemas/user-profile.schema.json",
  "title": "User Profile",
  "description": "Aiko と特定ユーザーの関係情報。設計書 §6.2。ユーザー端末にのみ保持し、外部へ送信しない（§11.2）。",
  "type": "object",
  "required": ["schema_version", "user_id"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "description": "このファイル形式の版。互換性判定に使う。",
      "type": "integer",
      "minimum": 1
    },
    "user_id": {
      "description": "同一端末内でユーザーを識別する名前。ファイル名・ディレクトリ名に使うため文字種を制限する。",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preferred_name": {
          "description": "Aiko がユーザーを呼ぶときの呼称。Relationship Consistency（§2）の対象。",
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "communication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": {
          "description": "応答に使う言語。BCP 47 の言語タグ。",
          "type": "string",
          "pattern": "^[a-zA-Z]{2,3}(-[a-zA-Z0-9]{2,8})*$"
        },
        "verbosity": {
          "type": "string",
          "enum": ["concise", "normal", "detailed"]
        },
        "directness": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "familiarity": {
          "type": "string",
          "enum": ["new", "developing", "established"]
        },
        "memory_namespace": {
          "description": "このユーザーの記憶を置く名前空間への参照。本体ではなく参照のみを持つ（§1.3 非目的）。",
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9/_-]{0,255}$"
        }
      }
    },
    "privacy": {
      "description": "既定は全て false。Fail Closed（§3.4）の思想に合わせ、明示的に true にしない限り外部へ出さない。",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow_remote_persona_service": {
          "type": "boolean",
          "default": false
        },
        "allow_usage_telemetry": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
